# Install Monitor – Vorlage. Nicht als gültige Zugangsdaten verwenden.
# python3 setup_credentials.py erzeugt eine private Datei install-monitor.env
# Das Secret signiert die Web-Sitzung; es ist KEIN zusätzliches Login-Eingabefeld.
IM_ADMIN_USERNAME=REPLACE_WITH_USERNAME
IM_ADMIN_PASSWORD_HASH=REPLACE_WITH_PBKDF2_SHA256_HASH
IM_SESSION_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS
# IM_COOKIE_SECURE=true  # Nur bei ausschließlich HTTPS-Zugriff aktivieren.
